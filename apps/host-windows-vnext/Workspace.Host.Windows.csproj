<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../host/**/*.cs" Exclude="../host/obj/**;../host/bin/**" />
    <ProjectReference Include="../../src/Workspace.Runtime/Workspace.Runtime.csproj" />
    <ProjectReference Include="../../src/Workspace.Storage/Workspace.Storage.csproj" />
    <ProjectReference Include="../../src/Workspace.Windows/Workspace.Windows.csproj" />
    <Content Include="../../examples/world-packages/m2a-brick/*" Link="examples/world-packages/m2a-brick/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
